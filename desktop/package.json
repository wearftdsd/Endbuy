{
  "name": "endbuy-desktop",
  "productName": "endBuy",
  "version": "1.0.0",
  "description": "endBuy — application de bureau (discussions, appels vocaux et vidéo, Nitro Lifetime offert)",
  "author": "endBuy",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "prepare-app": "node scripts/prepare.cjs",
    "icons": "electron scripts/make-icons.cjs",
    "start": "npm run prepare-app && electron .",
    "dist": "npm run prepare-app && electron-builder --win nsis portable --x64 --publish never",
    "dist:dir": "npm run prepare-app && electron-builder --win dir --x64 --publish never"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "ws": "^8.23.0"
  },
  "build": {
    "appId": "com.endbuy.desktop",
    "productName": "endBuy",
    "copyright": "endBuy",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "pages/**",
      "app-config.json",
      "server/**",
      "client/**",
      "build/icon.png",
      "build/badge.png",
      "build/tray.png",
      "package.json",
      "!**/*.map",
      "!**/{test,tests,__tests__,docs,example,examples}/**",
      "!**/*.{md,markdown,d.ts,d.cts,d.mts,ts}",
      "!node_modules/@electric-sql/pglite/dist/*.tar.gz"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/@electric-sql/pglite/**"
    ],
    "compression": "normal",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "executableName": "endBuy",
      "signAndEditExecutable": true
    },
    "nsis": {
      "artifactName": "endBuy-Setup.exe",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "endBuy",
      "runAfterFinish": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false,
      "language": "1036",
      "multiLanguageInstaller": true
    },
    "portable": {
      "artifactName": "endBuy.exe"
    }
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0"
  }
}
