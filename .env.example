# Domaine public de ton instance endBuy (doit pointer vers ton serveur)
ENDBUY_DOMAIN=endbuy.example.com
# Mot de passe de la base PostgreSQL (long et aléatoire)
POSTGRES_PASSWORD=change-moi-avec-une-longue-valeur-aleatoire
# Mot de passe du relais TURN (appels vocaux/vidéo derrière des NAT stricts)
TURN_PASSWORD=change-moi-aussi
